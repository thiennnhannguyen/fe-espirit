# URL gốc của backend API
VITE_API_BASE_URL=https://be-espirit-backend.onrender.com

# Key cho tích hợp bản đồ (Google Maps / Mapbox...)
VITE_MAP_API_KEY=

# Key cho tích hợp lịch (Google Calendar API)
VITE_GOOGLE_CALENDAR_CLIENT_ID=

# Endpoint / key cho trợ lý AI (chatbot)
VITE_AI_ASSISTANT_ENDPOINT=

# Cloudinary - Upload ảnh đại diện (Avatar)
# Tạo tại: https://cloudinary.com > Settings > Upload > Upload Presets > Add (Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
